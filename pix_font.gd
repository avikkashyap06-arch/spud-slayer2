const ALIAS := {"—": "-", "–": "-", "•": "*", "·": "*", "“": "\"", "”": "\"", "‘": "'", "’": "'", "…": ".", "×": "X", "é": "E", "→": ">", "←": "<", "♥": "*", "↑": "^", "↓": "V", "✓": "V", "↗": ">"}

static var _font: FontFile

static func get_font() -> FontFile:
	if _font != null:
		return _font
	var keys: Array = G.keys()
	var cols := 16
	var rows := int(ceil(float(keys.size()) / cols))
	var img := Image.create(cols * 8, rows * 8, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	var f := FontFile.new()
	f.fixed_size = 7
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.set_cache_ascent(0, 7, 7.0)
	f.set_cache_descent(0, 7, 1.0)
	var vs := Vector2i(7, 0)
	var idx := 0
	var cells := {}
	for k in keys:
		var cx := (idx % cols) * 8
		var cy := (idx / cols) * 8
		var rowsd: Array = G[k]
		for y in 7:
			for x in 5:
				if String(rowsd[y])[x] == "1":
					img.set_pixel(cx + x, cy + y, Color.WHITE)
		cells[k] = Rect2(cx, cy, 5, 7)
		idx += 1
	f.set_texture_image(0, vs, 0, img)
	var put := func(ch: String, src: String) -> void:
		var cp := ch.unicode_at(0)
		f.set_glyph_advance(0, 7, cp, Vector2(6, 0) if src != " " else Vector2(4, 0))
		f.set_glyph_offset(0, vs, cp, Vector2(0, -7))
		f.set_glyph_size(0, vs, cp, Vector2(5, 7))
		f.set_glyph_uv_rect(0, vs, cp, cells[src])
		f.set_glyph_texture_idx(0, vs, cp, 0)
	for k in keys:
		put.call(k, k)
		if k >= "A" and k <= "Z":
			put.call(String(k).to_lower(), k)
	for a in ALIAS:
		if ALIAS[a] in cells:
			put.call(a, ALIAS[a])
	_font = f
	return f
